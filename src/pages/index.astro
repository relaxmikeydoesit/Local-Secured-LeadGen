---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../site.config';
---

<BaseLayout>
  <section class="hero">
    <div class="wrap">
      <h1>{site.tagline}</h1>
      <p class="lead">{site.description}</p>
      <p class="actions">
        <a class="btn" href="/book/">Book now</a>
        <a class="btn btn-ghost" href="/contact/">Send a message</a>
      </p>
    </div>
  </section>

  <section class="wrap">
    <h2>What we do</h2>
    <ul class="cards">
      {site.services.map((s) => (
        <li>
          <h3>{s.name}</h3>
          <p>{s.blurb}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap">
    <h2>Where we work</h2>
    <p>{site.areaServed.join(', ')}</p>
  </section>
</BaseLayout>
